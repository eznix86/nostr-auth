# Secret key used to sign application sessions. Use a long random value, e.g. `openssl rand -hex 32`.
APP_KEY=2deaecd8a943194c6b8d7677a7d755985a15dde229a59c045ffa2cf9c6dd4143

# Human-friendly application name shown in the UI and page metadata.
APP_NAME=Nostr Auth

# Public base URL of the application. Used to derive the listen host/port and default cookie domain.
APP_URL=http://127.0.0.1:3000

# Optional path to the authorization policy JSON file. Defaults to `auth.json`.
AUTH_CONFIG_FILE=auth.json

# Nostr login challenge lifetime as a Go duration, for example `5m` or `30s`.
CHALLENGE_TTL=5m

# Optional cookie domain override for sharing auth cookies across subdomains, for example `.example.com`.
# Defaults from APP_URL when empty, and stays empty for localhost or IP-based URLs.
COOKIE_DOMAIN=

# Mark cookies as Secure. Set to `true` in HTTPS environments.
COOKIE_SECURE=true

# Session lifetime as a Go duration, for example `24h`, `168h`, or `30m`.
SESSION_TTL=168h

SSR_URL=http://127.0.0.1:13714
