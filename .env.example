# Secret key used to sign application sessions. Use a long random value, e.g. `openssl rand -hex 32`.
APP_KEY=change-me

# Human-friendly application name shown in the UI and page metadata.
APP_NAME=nostr-auth

# Optional HTTP bind host and port. Useful in containers where the public URL differs from the listen address.
HOST=127.0.0.1

PORT=3000

# Public base URL of the application. Used to derive the listen host/port and default cookie domain.
APP_URL=http://127.0.0.1:3000

# Optional path to the app config JSON file. Defaults to `config.json`.
CONFIG_FILE=config.json

# Nostr login challenge lifetime as a Go duration, for example `5m` or `30s`.
CHALLENGE_TTL=5m

# Optional cookie domain override for sharing auth cookies across subdomains, for example `.example.com`.
# Defaults from APP_URL when empty, and stays empty for localhost or IP-based URLs.
COOKIE_DOMAIN=

# Mark cookies as Secure. Set to `true` in HTTPS environments.
COOKIE_SECURE=false

# Optional Inertia SSR server URL. Leave empty to disable SSR.
# Normally it is http://127.0.0.1:13714
SSR_URL=

# Session lifetime as a Go duration, for example `24h`, `168h`, or `30m`.
SESSION_TTL=168h

# Timeout for each Nostr profile fetch attempt, as a Go duration such as `5s` or `10s`.
NOSTR_PROFILE_FETCH_TIMEOUT=5s

# In-memory cache lifetime for fetched Nostr profiles, as a Go duration such as `24h`.
NOSTR_PROFILE_CACHE_TTL=24h
